# Copy this file to .env and fill in real values before running the server

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/funcoin

# JWT configuration
JWT_SECRET=change_this_to_a_strong_secret
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Frontend URL used for password reset links
FRONTEND_URL=http://localhost:3000

# Nodemailer / Email settings
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email_user
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=no-reply@example.com

# Runtime
NODE_ENV=development
PORT=5000
# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/funcoin
## For MongoDB Atlas: mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_URL>/<DBNAME>


# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Email Configuration (for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@funcoin.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Admin Configuration
ADMIN_EMAIL=admin@funcoin.com
ADMIN_PASSWORD=change_this_password
